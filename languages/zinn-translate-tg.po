msgstr "Zinn Digital®"

#: includes/class-zinn-translate-admin-ui.php:294
msgid "Zinn Digital® — overview"
msgstr "Zinn Digital® — шарҳи умумӣ"

#: includes/class-zinn-translate-admin-ui.php:295
