msgstr "Stažená aktualizace neprošla kontrolou integrity a nebyla nainstalována."

#: includes/providers/class-zinn-translate-provider-deepl.php:157
msgid "No DeepL API key is saved, so there is nothing to translate with."
msgstr "Není uložen žádný klíč rozhraní DeepL API, takže není co překládat."

