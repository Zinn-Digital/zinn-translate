#: includes/class-zinn-translate-admin-ui.php:264
#: includes/class-zinn-translate-admin-ui.php:265
#: includes/class-zinn-translate-admin-ui.php:335
msgid "Zinn Digital®"
msgstr "Zinn Digital®"

#: includes/class-zinn-translate-admin-ui.php:278
