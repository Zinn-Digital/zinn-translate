msgstr "Zinn Digital® — přehled"

#: includes/class-zinn-translate-admin-ui.php:279
msgid "Overview"
msgstr "Přehled"

#: includes/class-zinn-translate-admin-ui.php:336
msgid "Every Zinn® plugin on this site, and whether it is working."
msgstr "Každý plugin Zinn® na tomto webu a zda funguje."

#: includes/class-zinn-translate-admin-ui.php:352
msgid "No connection is needed for this plugin."
msgstr "Pro tento plugin není potřeba žádné připojení."

#: includes/class-zinn-translate-admin-ui.php:357
msgid "Open settings"
msgstr "Otevřít nastavení"

#: includes/class-zinn-translate-admin-ui.php:685
#: includes/class-zinn-translate-admin-ui.php:1248
msgid "You do not have permission to change these settings."
msgstr "Nemáte oprávnění ke změně těchto nastavení."

#: includes/class-zinn-translate-admin-ui.php:715
msgid "Settings sections"
msgstr "Sekce nastavení"

#: includes/class-zinn-translate-admin-ui.php:788
msgid "Support"
msgstr "Podpora"

#: includes/class-zinn-translate-admin-ui.php:846
msgid "Save changes"
msgstr "Uložit změny"

#: includes/class-zinn-translate-admin-ui.php:875
msgid "Tools"
msgstr "Nástroje"

#: includes/class-zinn-translate-admin-ui.php:890
msgid "Export settings"
msgstr "Export nastavení"

#: includes/class-zinn-translate-admin-ui.php:893
msgid "Reset to defaults"
msgstr "Obnovit výchozí nastavení"

#: includes/class-zinn-translate-admin-ui.php:894
msgid "This puts every setting on this plugin back to its default. Continue?"
msgstr "Tímto se všechna nastavení tohoto pluginu vrátí na výchozí hodnoty. Pokračovat?"

#: includes/class-zinn-translate-admin-ui.php:901
msgid "Diagnostics for support"
msgstr "Diagnostika pro podporu"

#: includes/class-zinn-translate-admin-ui.php:910
msgid "Import a settings file"
msgstr "Importovat soubor nastavení"

#: includes/class-zinn-translate-admin-ui.php:912
msgid "Import"
msgstr "Importovat"

#: includes/class-zinn-translate-admin-ui.php:914
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "Exportované soubory nikdy neobsahují hesla, tokeny ani klíče API – na novém webu je budete muset zadat znovu."

#: includes/class-zinn-translate-admin-ui.php:1013
msgid "Settings saved."
msgstr "Nastavení uložena."

#: includes/class-zinn-translate-admin-ui.php:1060
msgid "Every setting on this plugin is back to its default."
msgstr "Všechna nastavení tohoto pluginu byla obnovena na výchozí hodnoty."

#: includes/class-zinn-translate-admin-ui.php:1103
msgid "Done."
msgstr "Hotovo."

#: includes/class-zinn-translate-admin-ui.php:1107
msgid "That action is not available."
msgstr "Tato akce není k dispozici."

#: includes/class-zinn-translate-admin-ui.php:1174
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "Tento soubor se nepodařilo přečíst. Zvolte soubor nastavení exportovaný z pluginu Zinn®."

#: includes/class-zinn-translate-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "Tento soubor je příliš velký na to, aby byl exportem nastavení."

#: includes/class-zinn-translate-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "Tento soubor není exportem nastavení Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-translate-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Tento soubor byl exportován z jiného modulu (%s), takže jeho importem by se uložilo nastavení, kterému tento modul nerozumí."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-translate-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d nastavení importováno. Hesla a klíče API se nikdy neexportují, takže je zadejte znovu."
msgstr[1] "%d nastavení importováno. Hesla a klíče API se neexportují, proto je zadejte znovu."
msgstr[2] "%d nastavení importováno. Hesla a klíče API se neexportují, proto je zadejte znovu."
msgstr[3] "%d nastavení importováno. Hesla a klíče API se neexportují, proto je zadejte znovu."

#: includes/class-zinn-translate-admin.php:65
msgid "Translate"
msgstr "Přeložit"

#: includes/class-zinn-translate-admin.php:79
msgid "Manual overrides"
msgstr "Manuální přepsání"

#: includes/class-zinn-translate-admin.php:84
msgid "Sitemaps and URLs"
msgstr "Mapy stránek a URL"

#: includes/class-zinn-translate-admin.php:114
msgid "General"
msgstr "Obecné"

#: includes/class-zinn-translate-admin.php:119
msgid "Who pays for the translation"
msgstr "Kdo platí za překlad"

#: includes/class-zinn-translate-admin.php:120
msgid "Either your Zinn Digital® plan, or an API key of your own. There is no free tier — somebody pays a provider for every word."
msgstr "Buď váš tarif Zinn Digital®, nebo váš vlastní klíč API. Neexistuje žádná bezplatná úroveň – za každé slovo platí poskytovateli někdo jiný."

#: includes/class-zinn-translate-admin.php:123
msgid "My Zinn Digital® plan"
msgstr "Můj plán u Zinn Digital®"

#: includes/class-zinn-translate-admin.php:124
msgid "My own provider key"
msgstr "Můj vlastní klíč poskytovatele"

#: includes/class-zinn-translate-admin.php:131
msgid "Site ID"
msgstr "ID webu"

#: includes/class-zinn-translate-admin.php:132
msgid "From your Zinn Digital® dashboard, on this site's Translation tab."
msgstr "Z vašeho řídicího panelu Zinn Digital® na kartě Překlad tohoto webu."

#: includes/class-zinn-translate-admin.php:139
msgid "Site token"
msgstr "Token webu"

#: includes/class-zinn-translate-admin.php:147
msgid "Provider"
msgstr "Poskytovatel"

#: includes/class-zinn-translate-admin.php:157
msgid "API key"
msgstr "API klíč"

#: includes/class-zinn-translate-admin.php:158
msgid "Your key, billed to you by the provider. It is stored on this site and sent only to them."
msgstr "Váš klíč, který vám účtuje poskytovatel. Je uložen na tomto webu a odesílá se pouze jemu."

#: includes/class-zinn-translate-admin.php:166
msgid "Model"
msgstr "Model"

#: includes/class-zinn-translate-admin.php:167
msgid "Leave empty for the cheapest model that does the job well."
msgstr "Nechte prázdné pro nejlevnější model, který dobře poslouží."

#: includes/class-zinn-translate-admin.php:174
msgid "This site is written in"
msgstr "Tento web je napsán v"

#: includes/class-zinn-translate-admin.php:175
msgid "Leave empty to use the site language from WordPress settings."
msgstr "Ponechte prázdné pro použití jazyka webu z nastavení WordPress."

#: includes/class-zinn-translate-admin.php:183
msgid "Languages to publish"
msgstr "Jazyky k publikování"

#: includes/class-zinn-translate-admin.php:184
msgid "Each one gets its own web addresses and its own sitemap. Publish only the languages you want indexed."
msgstr "Každý z nich získá vlastní webové adresy a vlastní soubor sitemap. Publikujte pouze ty jazyky, které chcete mít indexované."

#: includes/class-zinn-translate-admin.php:191
msgid "Translate automatically when I publish or update"
msgstr "Přeložit automaticky při publikování nebo aktualizaci"

#: includes/class-zinn-translate-admin.php:192
msgid "Editing a page marks its translations out of date and they are remade in the background. Editing without changing any words costs nothing."
msgstr "Úprava stránky označí její překlady za zastaralé a ty se vytvoří znovu na pozadí. Úprava bez změny jakýchkoli slov nestojí nic."

#: includes/class-zinn-translate-admin.php:199
msgid "What gets translated"
msgstr "Co se přeloží"

#: includes/class-zinn-translate-admin.php:204
msgid "Post types"
msgstr "Typy příspěvků"

#: includes/class-zinn-translate-admin.php:212
msgid "Translate the web addresses too"
msgstr "Přeložte také webové adresy"

#: includes/class-zinn-translate-admin.php:213
msgid "French visitors get /fr/a-propos/ rather than /fr/about/. The untranslated address keeps working and redirects, so nothing that was indexed breaks."
msgstr "Francouzští návštěvníci budou přesměrováni na /fr/a-propos/ namísto /fr/about/. Nepřeložená adresa bude nadále fungovat a provede přesměrování, takže nic, co již bylo indexováno, se neporouchá."

#: includes/class-zinn-translate-admin.php:220
msgid "Translate SEO titles, descriptions and image alt text"
msgstr "Přeložte SEO titulky, popisy a alt texty obrázků"

#: includes/class-zinn-translate-admin.php:227
msgid "Translate categories and tags"
msgstr "Přeložit kategorie a štítky"

#: includes/class-zinn-translate-admin.php:234
msgid "Translate navigation menus"
msgstr "Přeložit navigační menu"

#: includes/class-zinn-translate-admin.php:241
msgid "Translate WooCommerce products and attributes"
msgstr "Přeložit produkty a atributy WooCommerce"

#: includes/class-zinn-translate-admin.php:242
msgid "Short descriptions, purchase notes, attribute labels and variation descriptions. Prices, SKUs and stored option values are never touched."
msgstr "Krátké popisy, nákupní poznámky, štítky atributů a popisy variant. Ceny, SKU a uložené hodnoty možností zůstávají nedotčeny."

#: includes/class-zinn-translate-admin.php:249
msgid "SEO"
msgstr "SEO"

#: includes/class-zinn-translate-admin.php:254
msgid "Add hreflang tags"
msgstr "Přidat značky hreflang"

#: includes/class-zinn-translate-admin.php:255
msgid "Tells search engines these pages are the same page in different languages. Leave this on unless another plugin is already doing it."
msgstr "Říká vyhledávačům, že tyto stránky jsou stejnou stránkou v různých jazycích. Nechte toto zapnuté, pokud to již nedělá jiný plugin."

#: includes/class-zinn-translate-admin.php:262
msgid "Publish a sitemap for each language"
msgstr "Publikujte sitemapu pro každý jazyk"

#: includes/class-zinn-translate-admin.php:269
msgid "Publish llms.txt for each language"
msgstr "Publikovat llms.txt pro každý jazyk"

#: includes/class-zinn-translate-admin.php:270
msgid "A plain-text map of the site that AI answer engines read. They often cannot run JavaScript and may never fetch a sitemap."
msgstr "Textová mapa webu, kterou čtou vyhledávací moduly s umělou inteligencí. Často nedokážou spouštět JavaScript a sitemapu nemusí nikdy načíst."

#: includes/class-zinn-translate-admin.php:277
#: includes/class-zinn-translate-switcher.php:135
msgid "Language switcher"
msgstr "Přepínač jazyka"

#: includes/class-zinn-translate-admin.php:282
#: includes/class-zinn-translate-switcher-widget.php:83
msgid "Style"
msgstr "Styl"

#: includes/class-zinn-translate-admin.php:285
msgid "Colours, spacing and corners are on the Styling tab. Place it with the block, the [zinn_language_switcher] shortcode, or a menu."
msgstr "Barvy, řádkování a rohy se nacházejí na kartě Vzhled. Umístěte jej pomocí bloku, shortcodu [zinn_language_switcher] nebo menu."

#: includes/class-zinn-translate-admin.php:292
msgid "Show only these languages"
msgstr "Zobrazit pouze tyto jazyky"

#: includes/class-zinn-translate-admin.php:293
msgid "Leave empty to show every language you publish."
msgstr "Ponechte prázdné pro zobrazení každého jazyka, který publikujete."

#: includes/class-zinn-translate-admin.php:300
msgid "Name each language in its own language"
msgstr "Pojmenujte každý jazyk v jeho vlastním jazyce"

#: includes/class-zinn-translate-admin.php:301
msgid "Deutsch rather than German. Somebody who cannot read the current page cannot read \"German\" either."
msgstr "Deutsch místo German. Někdo, kdo neumí přečíst aktuální stránku, nedokáže přečíst ani „German“."

#: includes/class-zinn-translate-admin.php:308
msgid "Show flags"
msgstr "Zobrazit příznaky"

#: includes/class-zinn-translate-admin.php:309
msgid "Off by default: a language is not a country, and Arabic and Spanish have no single flag that does not exclude most of their speakers."
msgstr "Ve výchozím stavu vypnuto: jazyk není země a arabština ani španělština nemají jedinou vlajku, která by nevylučovala většinu jejich mluvčích."

#: includes/class-zinn-translate-admin.php:316
msgid "Include the language being read"
msgstr "Zahrnout čtený jazyk"

#: includes/class-zinn-translate-admin.php:323
msgid "Include the original language"
msgstr "Zahrnout původní jazyk"

#: includes/class-zinn-translate-admin.php:330
msgid "Add it to this menu"
msgstr "Přidat do této nabídky"

#: includes/class-zinn-translate-admin.php:331
msgid "Only the menu you name here. Nothing is added to any other menu on the site."
msgstr "Zobrazí se pouze nabídka, kterou zde pojmenujete. K žádné jiné nabídce na webu nebude nic přidáno."

#: includes/class-zinn-translate-admin.php:381
msgid "Accent"
msgstr "Styl"

#: includes/class-zinn-translate-admin.php:385
msgid "Background"
msgstr "Pozadí"

#: includes/class-zinn-translate-admin.php:389
msgid "Text"
msgstr "Text"

#: includes/class-zinn-translate-admin.php:393
msgid "Corner radius"
msgstr "Poloměr rohu"

#: includes/class-zinn-translate-admin.php:397
msgid "Spacing"
msgstr "Odsazení"

#: includes/class-zinn-translate-admin.php:401
msgid "Text size"
msgstr "Velikost textu"

#: includes/class-zinn-translate-admin.php:428
msgid "Do not add it to a menu"
msgstr "Nepřidávat do nabídky"

#: includes/class-zinn-translate-admin.php:483
msgid "Edit any translation here. An edited translation is kept exactly as you wrote it and is never overwritten when the page is translated again."
msgstr "Zde můžete upravit jakýkoliv překlad. Upravený překlad zůstane přesně tak, jak jste jej napsali, a nikdy nebude přepsán při dalším překladu stránky."

#: includes/class-zinn-translate-admin.php:504
msgid "Every language"
msgstr "Každý jazyk"

#: includes/class-zinn-translate-admin.php:511
msgid "Search translations"
msgstr "Hledat překlady"

#: includes/class-zinn-translate-admin.php:512
msgid "Filter"
msgstr "Filtrovat"

#: includes/class-zinn-translate-admin.php:517
msgid "Content"
msgstr "Obsah"

#: includes/class-zinn-translate-admin.php:518
msgid "Language"
msgstr "Jazyk"

#: includes/class-zinn-translate-admin.php:519
msgid "Translation"
msgstr "Překlad"

#: includes/class-zinn-translate-admin.php:520
msgid "Status"
msgstr "Stav"

#: includes/class-zinn-translate-admin.php:521
#: includes/class-zinn-translate-admin.php:540
msgid "Save"
msgstr "Uložit"

#: includes/class-zinn-translate-admin.php:526
msgid "Nothing translated yet. Publish a language and translation starts in the background."
msgstr "Zatím nebylo nic přeloženo. Publikujte jazyk a překlad se spustí na pozadí."

#: includes/class-zinn-translate-admin.php:559
msgid "These addresses are live. Open any of them to check it, and submit the sitemap index to Google Search Console."
msgstr "Tyto adresy jsou aktivní. Otevřete kteroukoli z nich a zkontrolujte ji, a odešlete index sitemap do nástroje Google Search Console."

#: includes/class-zinn-translate-admin.php:580
msgid "You are not allowed to edit translations on this site."
msgstr "Nemáte oprávnění upravovat překlady na tomto webu."

#: includes/class-zinn-translate-admin.php:608
msgid "Edited by you — kept"
msgstr "Upraveno vámi — ponecháno"

#: includes/class-zinn-translate-admin.php:610
msgid "Source changed — will be redone"
msgstr "Zdroj se změnil – bude přepracován"

#: includes/class-zinn-translate-admin.php:612
msgid "Up to date"
msgstr "Aktuální"

#: includes/class-zinn-translate-connection.php:58
msgid "Connected"
msgstr "Připojeno"

#: includes/class-zinn-translate-connection.php:60
msgid "Connecting…"
msgstr "Připojování…"

#: includes/class-zinn-translate-connection.php:62
msgid "Connected, but something needs attention"
msgstr "Připojeno, ale některé položky vyžadují pozornost"

#: includes/class-zinn-translate-connection.php:64
msgid "Not connected"
msgstr "Nepřipojeno"

#: includes/class-zinn-translate-connection.php:66
msgid "Running on your own account"
msgstr "Běží na vašem účtu"

#: includes/class-zinn-translate-connection.php:68
msgid "We could not check this"
msgstr "To se nám nepodařilo ověřit"

#: includes/class-zinn-translate-connection.php:93
msgid "This plugin did not say why. Send a diagnostics report and we will look."
msgstr "Tento doplněk neuvedl důvod. Odešlete diagnostickou zprávu a podíváme se na to."

#: includes/class-zinn-translate-connection.php:161
msgid "Connection status"
msgstr "Stav připojení"

#. translators: %s: a human-readable interval such as "5 minutes".
#: includes/class-zinn-translate-connection.php:189
#, php-format
msgid "Last checked %s ago."
msgstr "Naposledy zkontrolováno před %s."

#: includes/class-zinn-translate-connection.php:251
msgid "(opens in a new tab)"
msgstr "(otevře se na nové kartě)"

#: includes/class-zinn-translate-diagnostics.php:199
msgid "Send this to Zinn® support"
msgstr "Odeslat na podporu Zinn®"

#: includes/class-zinn-translate-diagnostics.php:201
msgid "This is exactly what will be sent — nothing else, and nothing hidden. Your passwords, tokens and API keys are not in it."
msgstr "Přesně toto bude odesláno – nic jiného a nic skrytého. Vaše hesla, tokeny a klíče API v tom nejsou obsaženy."

#: includes/class-zinn-translate-diagnostics.php:204
msgid "The diagnostics report that will be sent"
msgstr "Diagnostická zpráva, která bude odeslána"

#: includes/class-zinn-translate-diagnostics.php:207
msgid "Copy to clipboard"
msgstr "Kopírovat do schránky"

#: includes/class-zinn-translate-diagnostics.php:214
msgid "Send this report to Zinn® support"
msgstr "Odeslat tuto sestavu na podporu Zinn®"

#: includes/class-zinn-translate-diagnostics.php:216
msgid "We open a support ticket for you and reply by email. If you would rather not send it, copy it above and paste it into a ticket yourself."
msgstr "Vytvoříme pro vás tiket podpory a odpovíme vám e-mailem. Pokud ho raději nechcete odesílat, zkopírujte ho výše a vložte si jej do tiketu sami."

#: includes/class-zinn-translate-diagnostics.php:228
msgid "Copied"
msgstr "Zkopírováno"

#. translators: %s: the transport error reported by WordPress.
#: includes/class-zinn-translate-diagnostics.php:274
#, php-format
msgid "We could not reach Zinn Digital® from this server (%s). Copy the report above and open a ticket instead — nothing about your settings is wrong."
msgstr "Zinn Digital® se nepodařilo z tohoto serveru (%s) kontaktovat. Zkopírujte výše uvedenou zprávu a raději otevřete tiket – ve vašem nastavení není nic špatně."

#: includes/class-zinn-translate-diagnostics.php:288
msgid "Sent. Zinn® support has your report and will reply by email."
msgstr "Podpora Zinn® obdržela vaše hlášení a odpoví vám e-mailem."

#. translators: %s: the support reference for the report just sent.
#: includes/class-zinn-translate-diagnostics.php:291
#, php-format
msgid "Sent. Zinn® support has your report — reference %s — and will reply by email."
msgstr "Podpora Zinn® eviduje vaše hlášení – referenční číslo %s – a odpoví vám e-mailem."

#: includes/class-zinn-translate-diagnostics.php:300
msgid "You have sent several reports in a short time. Wait a few minutes and try again — the earlier ones did arrive."
msgstr "Odeslali jste několik hlášení v krátké době. Počkejte několik minut a zkuste to znovu – ty předchozí dorazily."

#: includes/class-zinn-translate-diagnostics.php:307
msgid "Zinn Digital® could not accept the report just now — that is our end, not yours. Try again shortly, or copy the report above into a ticket."
msgstr "Zinn Digital® nyní nemohl zprávu přijmout – chyba je na naší straně, nikoli vaší. Zkuste to brzy znovu nebo zkopírujte výše uvedenou zprávu do ticketu."

#. translators: %d: the HTTP status code the server returned.
#: includes/class-zinn-translate-diagnostics.php:315
#, php-format
msgid "The report was refused (HTTP %d). Copy it above and open a ticket, quoting that number."
