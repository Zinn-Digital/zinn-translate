msgstr "A bővítmény nem adta meg az okot. Egy diagnosztikai jelentés elküldése után utánajárunk."

#: includes/class-zinn-translate-connection.php:161
msgid "Connection status"
msgstr "Kapcsolat állapota"

#. translators: %s: a human-readable interval such as "5 minutes".
#: includes/class-zinn-translate-connection.php:189
#, php-format
msgid "Last checked %s ago."
msgstr "Utoljára ellenőrizve %s ezelőtt."

#: includes/class-zinn-translate-connection.php:251
msgid "(opens in a new tab)"
msgstr "(új lapon nyílik meg)"

#: includes/class-zinn-translate-diagnostics.php:199
msgid "Send this to Zinn® support"
msgstr "Küldje el ezt a Zinn® támogatásának"

#: includes/class-zinn-translate-diagnostics.php:201
msgid "This is exactly what will be sent — nothing else, and nothing hidden. Your passwords, tokens and API keys are not in it."
msgstr "Pontosan ez kerül elküldésre — semmi más, és semmi rejtett dolog. A jelszavak, tokenek és API-kulcsok nem szerepelnek benne."

#: includes/class-zinn-translate-diagnostics.php:204
