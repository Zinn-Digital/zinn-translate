msgstr "Skopiowano"

#: includes/class-zinn-translate-admin-ui.php:422
msgid "Every Zinn® plugin on this site, and whether it is working."
msgstr "Każda wtyczka Zinn® w tej witrynie oraz informacja, czy działa."

#: includes/class-zinn-translate-admin-ui.php:437
msgid "No connection is needed for this plugin."
msgstr "Dla tej wtyczki nie jest wymagane żadne połączenie."

#: includes/class-zinn-translate-admin-ui.php:442
