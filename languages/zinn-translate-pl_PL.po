msgstr "Otwórz ustawienia"

#: includes/class-zinn-translate-admin-ui.php:770
#: includes/class-zinn-translate-admin-ui.php:1331
msgid "You do not have permission to change these settings."
msgstr "Nie masz uprawnień do zmiany tych ustawień."

#: includes/class-zinn-translate-admin-ui.php:799
msgid "Settings sections"
msgstr "Sekcje ustawień"

#: includes/class-zinn-translate-admin-ui.php:871
msgid "Support"
msgstr "Wsparcie"

#: includes/class-zinn-translate-admin-ui.php:929
msgid "Save changes"
msgstr "Zapisz zmiany"

#: includes/class-zinn-translate-admin-ui.php:958
msgid "Tools"
msgstr "Narzędzia"

#: includes/class-zinn-translate-admin-ui.php:973
msgid "Export settings"
msgstr "Eksportuj ustawienia"

#: includes/class-zinn-translate-admin-ui.php:976
msgid "Reset to defaults"
msgstr "Przywróć domyślne"

#: includes/class-zinn-translate-admin-ui.php:977
msgid "This puts every setting on this plugin back to its default. Continue?"
msgstr "Spowoduje to przywrócenie wszystkich ustawień tej wtyczki do wartości domyślnych. Chcesz kontynuować?"

#: includes/class-zinn-translate-admin-ui.php:984
msgid "Diagnostics for support"
msgstr "Diagnostyka dla wsparcia"

#: includes/class-zinn-translate-admin-ui.php:993
msgid "Import a settings file"
msgstr "Zaimportuj plik ustawień"

#: includes/class-zinn-translate-admin-ui.php:995
msgid "Import"
msgstr "Importuj"

#: includes/class-zinn-translate-admin-ui.php:997
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "Wyeksportowane pliki nigdy nie zawierają haseł, tokenów ani kluczy API — musisz wprowadzić je ponownie w nowej witrynie."

#: includes/class-zinn-translate-admin-ui.php:1096
msgid "Settings saved."
msgstr "Ustawienia zostały zapisane."

#: includes/class-zinn-translate-admin-ui.php:1143
msgid "Every setting on this plugin is back to its default."
msgstr "Wszystkie ustawienia tej wtyczki zostały przywrócone do wartości domyślnych."

#: includes/class-zinn-translate-admin-ui.php:1186
msgid "Done."
msgstr "Gotowe."

#: includes/class-zinn-translate-admin-ui.php:1190
msgid "That action is not available."
msgstr "Ta akcja jest niedostępna."

#: includes/class-zinn-translate-admin-ui.php:1257
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "Nie udało się odczytać tego pliku. Wybierz plik ustawień wyeksportowany z wtyczki Zinn®."

#: includes/class-zinn-translate-admin-ui.php:1265
msgid "That file is too large to be a settings export."
msgstr "Ten plik jest zbyt duży, aby mógł być eksportem ustawień."

#: includes/class-zinn-translate-admin-ui.php:1278
msgid "That file is not a Zinn® settings export."
msgstr "Ten plik nie jest eksportem ustawień Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-translate-admin-ui.php:1286
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Ten plik został wyeksportowany z innej wtyczki (%s), więc zaimportowanie go tutaj spowoduje zapisanie ustawień, których ta wtyczka nie rozumie."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-translate-admin-ui.php:1316
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Zaimportowano %d ustawienie. Hasła i klucze API nigdy nie są zawarte w eksporcie, więc wprowadź je ponownie."
msgstr[1] "Zaimportowano %d ustawień. Hasła i klucze API nigdy nie znajdują się w pliku eksportu, więc wprowadź je ponownie."
msgstr[2] "Zaimportowano %d ustawień. Hasła i klucze API nigdy nie znajdują się w pliku eksportu, więc wprowadź je ponownie."

#: includes/class-zinn-translate-admin.php:65
msgid "Translate"
msgstr "Przetłumacz"

#: includes/class-zinn-translate-admin.php:79
msgid "Manual overrides"
msgstr "Ręczne nadpisania"

#: includes/class-zinn-translate-admin.php:84
msgid "Sitemaps and URLs"
msgstr "Mapy witryny i adresy URL"

#: includes/class-zinn-translate-admin.php:114
msgid "General"
msgstr "Ogólne"

#: includes/class-zinn-translate-admin.php:119
msgid "Who pays for the translation"
msgstr "Kto płaci za tłumaczenie"

#: includes/class-zinn-translate-admin.php:120
msgid "Either your Zinn Digital® plan, or an API key of your own. There is no free tier — somebody pays a provider for every word."
msgstr "Twój plan Zinn Digital® albo Twój własny klucz API. Nie ma darmowego pakietu — ktoś płaci dostawcy za każde słowo."

#: includes/class-zinn-translate-admin.php:123
msgid "My Zinn Digital® plan"
msgstr "Mój plan Zinn Digital®"

#: includes/class-zinn-translate-admin.php:124
msgid "My own provider key"
msgstr "Mój własny klucz dostawcy"

#: includes/class-zinn-translate-admin.php:131
msgid "Site ID"
msgstr "ID witryny"

#: includes/class-zinn-translate-admin.php:132
msgid "From your Zinn Digital® dashboard, on this site's Translation tab."
msgstr "Z Twojego kokpitu Zinn Digital®, w zakładce Translation tej witryny."

#: includes/class-zinn-translate-admin.php:139
msgid "Site token"
msgstr "Token witryny"

#: includes/class-zinn-translate-admin.php:142
msgid "An API key from your Zinn Digital® dashboard, on its API keys page. Give it the sites.view and sites.translation.manage permissions."
msgstr "Klucz API z twojego kokpitu Zinn Digital®, na stronie kluczy API. Nadaj mu uprawnienia sites.view oraz sites.translation.manage."

#: includes/class-zinn-translate-admin.php:150
msgid "Provider"
msgstr "Dostawca"

#: includes/class-zinn-translate-admin.php:160
msgid "API key"
msgstr "Klucz API"

#: includes/class-zinn-translate-admin.php:161
msgid "Your key, billed to you by the provider. It is stored on this site and sent only to them."
msgstr "Twój klucz, za który rachunek wystawia dostawca. Jest przechowywany na tej witrynie i wysyłany wyłącznie do niego."

#: includes/class-zinn-translate-admin.php:169
msgid "Model"
msgstr "Model"

#: includes/class-zinn-translate-admin.php:170
msgid "Leave empty for the cheapest model that does the job well."
msgstr "Zostaw puste, aby wybrać najtańszy model, który dobrze wykona zadanie."

#: includes/class-zinn-translate-admin.php:177
msgid "This site is written in"
msgstr "Ta witryna jest napisana w języku"

#: includes/class-zinn-translate-admin.php:178
msgid "Leave empty to use the site language from WordPress settings."
msgstr "Pozostaw puste, aby użyć języka witryny z ustawień WordPressa."

#: includes/class-zinn-translate-admin.php:189
msgid "Languages to publish"
msgstr "Języki do opublikowania"

#: includes/class-zinn-translate-admin.php:190
msgid "Each one gets its own web addresses and its own sitemap. Publish only the languages you want indexed."
msgstr "Każdy otrzymuje własne adresy internetowe i własną mapę witryny. Publikuj tylko te języki, które chcesz zindeksować."

#: includes/class-zinn-translate-admin.php:206
msgid "Translate automatically when I publish or update"
msgstr "Tłumacz automatycznie, gdy publikuję lub aktualizuję"

#: includes/class-zinn-translate-admin.php:207
msgid "Editing a page marks its translations out of date and they are remade in the background. Editing without changing any words costs nothing."
msgstr "Edycja strony oznacza jej tłumaczenia jako nieaktualne i są one tworzone na nowo w tle. Edycja bez zmiany jakichkolwiek słów nic nie kosztuje."

#: includes/class-zinn-translate-admin.php:214
msgid "What gets translated"
msgstr "Co jest tłumaczone"

#: includes/class-zinn-translate-admin.php:219
msgid "Post types"
msgstr "Typy wpisów"

#: includes/class-zinn-translate-admin.php:232
msgid "Translate the web addresses too"
msgstr "Przetłumacz również adresy internetowe"

#: includes/class-zinn-translate-admin.php:233
msgid "French visitors get /fr/a-propos/ rather than /fr/about/. The untranslated address keeps working and redirects, so nothing that was indexed breaks."
msgstr "Odwiedzający z Francji trafiają na /fr/a-propos/ zamiast /fr/about/. Nieprzetłumaczony adres nadal działa i przekierowuje, więc nic z zaindeksowanych treści nie przestaje działać."

#: includes/class-zinn-translate-admin.php:240
msgid "Translate SEO titles, descriptions and image alt text"
msgstr "Tłumacz tytuły SEO, opisy i tekst alternatywny obrazów"

#: includes/class-zinn-translate-admin.php:247
msgid "Translate categories and tags"
msgstr "Przetłumacz kategorie i tagi"

#: includes/class-zinn-translate-admin.php:254
msgid "Translate navigation menus"
msgstr "Przetłumacz menu nawigacyjne"

#: includes/class-zinn-translate-admin.php:261
msgid "Translate WooCommerce products and attributes"
msgstr "Tłumacz produkty i atrybuty WooCommerce"

#: includes/class-zinn-translate-admin.php:262
msgid "Short descriptions, purchase notes, attribute labels and variation descriptions. Prices, SKUs and stored option values are never touched."
msgstr "Krótkie opisy, uwagi do zakupu, etykiety atrybutów i opisy wariantów. Ceny, kody SKU i zapisane wartości opcji nigdy nie są modyfikowane."

#: includes/class-zinn-translate-admin.php:269
msgid "SEO"
msgstr "SEO"

#: includes/class-zinn-translate-admin.php:274
msgid "Add hreflang tags"
msgstr "Dodaj tagi hreflang"

#: includes/class-zinn-translate-admin.php:275
msgid "Tells search engines these pages are the same page in different languages. Leave this on unless another plugin is already doing it."
msgstr "Informuje wyszukiwarki, że te strony to ta sama strona w różnych językach. Pozostaw tę opcję włączoną, chyba że robi to już inna wtyczka."

#: includes/class-zinn-translate-admin.php:282
msgid "Publish a sitemap for each language"
msgstr "Opublikuj mapę witryny dla każdego języka"

#: includes/class-zinn-translate-admin.php:289
msgid "Publish llms.txt for each language"
msgstr "Publikuj llms.txt dla każdego języka"

#: includes/class-zinn-translate-admin.php:290
msgid "A plain-text map of the site that AI answer engines read. They often cannot run JavaScript and may never fetch a sitemap."
msgstr "Mapa witryny w formacie zwykłego tekstu, którą odczytują silniki odpowiedzi AI. Często nie potrafią one uruchamiać JavaScriptu i mogą nigdy nie pobrać mapy witryny."

#: includes/class-zinn-translate-admin.php:297
#: includes/class-zinn-translate-switcher.php:138
msgid "Language switcher"
msgstr "Przełącznik języka"

#: includes/class-zinn-translate-admin.php:302
#: includes/class-zinn-translate-switcher-widget.php:79
msgid "Style"
msgstr "Styl"

#: includes/class-zinn-translate-admin.php:305
msgid "Colours, spacing and corners are on the Styling tab. Place it with the block, the [zinn_language_switcher] shortcode, or a menu."
msgstr "Kolory, odstępy i zaokrąglenia znajdziesz w zakładce Styl. Umieść go za pomocą bloku, shortcode'a [zinn_language_switcher] lub menu."

#: includes/class-zinn-translate-admin.php:312
msgid "Show only these languages"
msgstr "Pokaż tylko te języki"

#: includes/class-zinn-translate-admin.php:313
msgid "Leave empty to show every language you publish."
msgstr "Pozostaw puste, aby wyświetlić każdy język, w którym publikujesz."

#: includes/class-zinn-translate-admin.php:319
msgid "Name each language in its own language"
msgstr "Nazwij każdy język w jego własnym języku"

#: includes/class-zinn-translate-admin.php:320
msgid "Deutsch rather than German. Somebody who cannot read the current page cannot read \"German\" either."
msgstr "Deutsch zamiast German. Ktoś, kto nie potrafi przeczytać bieżącej strony, nie przeczyta również „German”."

#: includes/class-zinn-translate-admin.php:327
msgid "Show flags"
msgstr "Pokaż flagi"

#: includes/class-zinn-translate-admin.php:328
msgid "Off by default: a language is not a country, and Arabic and Spanish have no single flag that does not exclude most of their speakers."
msgstr "Domyślnie wyłączone: język to nie kraj, a arabski i hiszpański nie mają jednej flagi, która nie wykluczałaby większości osób nimi mówiących."

#: includes/class-zinn-translate-admin.php:335
msgid "Include the language being read"
msgstr "Dołącz czytany język"

#: includes/class-zinn-translate-admin.php:342
msgid "Include the original language"
msgstr "Dołącz język oryginalny"

#: includes/class-zinn-translate-admin.php:349
msgid "Add it to this menu"
msgstr "Dodaj to do tego menu"

#: includes/class-zinn-translate-admin.php:350
msgid "Only the menu you name here. Nothing is added to any other menu on the site."
msgstr "Tylko menu, które tutaj nadasz nazwę. Nic nie zostanie dodane do żadnego innego menu w witrynie."

#: includes/class-zinn-translate-admin.php:400
msgid "Accent"
msgstr "Akcent"

#: includes/class-zinn-translate-admin.php:404
msgid "Background"
msgstr "Tło"

#: includes/class-zinn-translate-admin.php:408
msgid "Text"
msgstr "Tekst"

#: includes/class-zinn-translate-admin.php:412
msgid "Corner radius"
msgstr "Promień narożnika"

#: includes/class-zinn-translate-admin.php:416
msgid "Spacing"
msgstr "Odstępy"

#: includes/class-zinn-translate-admin.php:420
msgid "Text size"
msgstr "Rozmiar tekstu"

#: includes/class-zinn-translate-admin.php:447
msgid "Do not add it to a menu"
msgstr "Nie dodawaj tego do menu"

#: includes/class-zinn-translate-admin.php:468
msgid "none"
msgstr "brak"

#. translators: %s: comma-separated language names, or "none".
#: includes/class-zinn-translate-admin.php:471
#, php-format
msgid "On a Zinn Digital® plan you choose the languages to publish on this site's Translation tab in your dashboard, under \"Shown to visitors\". This site checks it every hour. Publishing now: %s."
msgstr "W planie Zinn Digital® języki do opublikowania wybierasz w zakładce Tłumaczenie w kokpicie tej witryny, w sekcji „Shown to visitors”. Ta witryna sprawdza to co godzinę. Publikowane teraz: %s."

#. translators: %s: comma-separated language names, or "none".
#: includes/class-zinn-translate-admin.php:474
#, php-format
msgid "On a Zinn Digital® plan you choose the languages to publish on this site's Translation tab in your dashboard. This site has not read that choice yet, so it is still publishing: %s. Check the Site ID and token above."
msgstr "W planie Zinn Digital® języki do publikacji wybierasz w zakładce Tłumaczenie dla tej witryny w swoim kokpicie. Ta witryna jeszcze nie odczytała tego wyboru, dlatego nadal publikuje: %s. Sprawdź identyfikator witryny i token powyżej."

#: includes/class-zinn-translate-admin.php:525
msgid "Edit any translation here. An edited translation is kept exactly as you wrote it and is never overwritten when the page is translated again."
msgstr "Edytuj dowolne tłumaczenie tutaj. Edytowane tłumaczenie jest zachowywane dokładnie w takiej postaci, w jakiej zostało napisane, i nigdy nie jest nadpisywane podczas ponownego tłumaczenia strony."

#: includes/class-zinn-translate-admin.php:546
msgid "Every language"
msgstr "Wszystkie języki"

#: includes/class-zinn-translate-admin.php:553
msgid "Search translations"
msgstr "Szukaj tłumaczeń"

#: includes/class-zinn-translate-admin.php:554
msgid "Filter"
msgstr "Filtruj"

#: includes/class-zinn-translate-admin.php:559
msgid "Content"
msgstr "Treść"

#: includes/class-zinn-translate-admin.php:560
msgid "Language"
msgstr "Język"

#: includes/class-zinn-translate-admin.php:561
msgid "Translation"
msgstr "Tłumaczenie"

#: includes/class-zinn-translate-admin.php:562
msgid "Status"
msgstr "Status"

#: includes/class-zinn-translate-admin.php:563
#: includes/class-zinn-translate-admin.php:582
msgid "Save"
msgstr "Zapisz"

#: includes/class-zinn-translate-admin.php:568
msgid "Nothing translated yet. Publish a language and translation starts in the background."
msgstr "Nic jeszcze nie przetłumaczono. Opublikuj język, a tłumaczenie rozpocznie się w tle."

#: includes/class-zinn-translate-admin.php:601
msgid "These addresses are live. Open any of them to check it, and submit the sitemap index to Google Search Console."
msgstr "Te adresy są aktywne. Otwórz dowolny z nich, aby go sprawdzić, i prześlij indeks mapy witryny do Google Search Console."

#: includes/class-zinn-translate-admin.php:622
msgid "You are not allowed to edit translations on this site."
msgstr "Nie masz uprawnień do edytowania tłumaczeń na tej witrynie."

#: includes/class-zinn-translate-admin.php:650
msgid "Edited by you — kept"
msgstr "Edytowane przez ciebie — zachowano"

#: includes/class-zinn-translate-admin.php:652
msgid "Source changed — will be redone"
msgstr "Źródło uległo zmianie — zostanie wykonane ponownie"

#: includes/class-zinn-translate-admin.php:654
msgid "Up to date"
msgstr "Aktualne"

#: includes/class-zinn-translate-connection.php:58
msgid "Connected"
msgstr "Połączono"

#: includes/class-zinn-translate-connection.php:60
msgid "Connecting…"
msgstr "Łączenie…"

#: includes/class-zinn-translate-connection.php:62
msgid "Connected, but something needs attention"
msgstr "Połączono, ale coś wymaga uwagi"

#: includes/class-zinn-translate-connection.php:64
msgid "Not connected"
msgstr "Niepołączono"

#: includes/class-zinn-translate-connection.php:66
msgid "Running on your own account"
msgstr "Działa na Twoim własnym koncie"

#: includes/class-zinn-translate-connection.php:68
msgid "We could not check this"
msgstr "Nie mogliśmy tego sprawdzić"

#: includes/class-zinn-translate-connection.php:93
msgid "This plugin did not say why. Send a diagnostics report and we will look."
msgstr "Ta wtyczka nie podała powodu. Wyślij raport diagnostyczny, a my to sprawdzimy."

#: includes/class-zinn-translate-connection.php:161
msgid "Connection status"
msgstr "Stan połączenia"

#. translators: %s: a human-readable interval such as "5 minutes".
#: includes/class-zinn-translate-connection.php:189
#, php-format
msgid "Last checked %s ago."
msgstr "Ostatnio sprawdzono %s temu."

#: includes/class-zinn-translate-connection.php:251
msgid "(opens in a new tab)"
msgstr "(otwiera się w nowej karcie)"

#: includes/class-zinn-translate-diagnostics.php:199
msgid "Send this to Zinn® support"
msgstr "Wyślij to do wsparcia Zinn®"

#: includes/class-zinn-translate-diagnostics.php:201
msgid "This is exactly what will be sent — nothing else, and nothing hidden. Your passwords, tokens and API keys are not in it."
msgstr "Dokładnie to zostanie wysłane — nic więcej i nic ukrytego. Twoich haseł, tokenów ani kluczy API w tym nie ma."

#: includes/class-zinn-translate-diagnostics.php:204
msgid "The diagnostics report that will be sent"
msgstr "Raport diagnostyczny, który zostanie wysłany"

#: includes/class-zinn-translate-diagnostics.php:207
msgid "Copy to clipboard"
msgstr "Skopiuj do schowka"

#: includes/class-zinn-translate-diagnostics.php:214
msgid "Send this report to Zinn® support"
msgstr "Wyślij ten raport do pomocy technicznej Zinn®"

#: includes/class-zinn-translate-diagnostics.php:216
msgid "We open a support ticket for you and reply by email. If you would rather not send it, copy it above and paste it into a ticket yourself."
msgstr "Otwieramy dla Ciebie zgłoszenie do pomocy technicznej i odpowiadamy e-mailem. Jeśli wolisz go nie wysyłać, skopiuj go powyżej i wklej do zgłoszenia samodzielnie."

#. translators: %s: the transport error reported by WordPress.
#: includes/class-zinn-translate-diagnostics.php:270
#, php-format
msgid "We could not reach Zinn Digital® from this server (%s). Copy the report above and open a ticket instead — nothing about your settings is wrong."
msgstr "Nie udało się połączyć z Zinn Digital® z tego serwera (%s). Skopiuj powyższy raport i zamiast tego otwórz zgłoszenie — z twoimi ustawieniami wszystko jest w porządku."

#: includes/class-zinn-translate-diagnostics.php:284
msgid "Sent. Zinn® support has your report and will reply by email."
msgstr "Wysłano. Wsparcie Zinn® otrzymało Twoje zgłoszenie i odpowie pocztą e-mail."

#. translators: %s: the support reference for the report just sent.
#: includes/class-zinn-translate-diagnostics.php:287
#, php-format
msgid "Sent. Zinn® support has your report — reference %s — and will reply by email."
msgstr "Wysłano. Zespół pomocy Zinn® otrzymał Twoje zgłoszenie — numer referencyjny %s — i odpowie drogą mailową."

#: includes/class-zinn-translate-diagnostics.php:296
msgid "You have sent several reports in a short time. Wait a few minutes and try again — the earlier ones did arrive."
msgstr "Wysłałeś kilka zgłoszeń w krótkim czasie. Odczekaj kilka minut i spróbuj ponownie — wcześniejsze dotarły."

#: includes/class-zinn-translate-diagnostics.php:303
msgid "Zinn Digital® could not accept the report just now — that is our end, not yours. Try again shortly, or copy the report above into a ticket."
msgstr "Zinn Digital® nie mógł teraz przyjąć zgłoszenia — błąd leży po naszej stronie, nie po twojej. Spróbuj ponownie za chwilę lub skopiuj powyższe zgłoszenie do ticketa."

#. translators: %d: the HTTP status code the server returned.
#: includes/class-zinn-translate-diagnostics.php:311
#, php-format
msgid "The report was refused (HTTP %d). Copy it above and open a ticket, quoting that number."
msgstr "Raport został odrzucony (HTTP %d). Skopiuj go powyżej i otwórz zgłoszenie, podając ten numer."

