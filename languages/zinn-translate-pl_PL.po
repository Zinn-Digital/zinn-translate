msgstr "Pozwól odwiedzającym czytać tę stronę w innym języku."

#: includes/class-zinn-translate-switcher-widget.php:79
msgid "Title"
msgstr "Tytuł"

#: includes/class-zinn-translate-switcher-widget.php:85
