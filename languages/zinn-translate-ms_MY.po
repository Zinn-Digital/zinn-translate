msgstr "Kunci anda, dibilkan kepada anda oleh penyedia. Ia disimpan di tapak ini dan dihantar hanya kepada mereka."

#: includes/class-zinn-translate-admin.php:166
msgid "Model"
msgstr "Model"

#: includes/class-zinn-translate-admin.php:167
msgid "Leave empty for the cheapest model that does the job well."
msgstr "Biarkan kosong untuk model termurah yang berfungsi dengan baik."

