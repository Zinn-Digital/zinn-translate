#. Plugin Name of the plugin
#: zinn-translate.php
#: includes/class-zinn-translate-admin.php:706
msgid "Zinn® Translate"
msgstr "Zinn® Translate"

#. Plugin URI of the plugin
#: zinn-translate.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-translate"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-translate"

#. Description of the plugin
#: zinn-translate.php
msgid "Publishes this site in every language you choose, on its own web addresses, with translated slugs, metadata, menus, WooCommerce products, hreflang, per-language sitemaps and llms.txt. Translate with your Zinn Digital® plan or with your own provider key."
msgstr "מפרסם את האתר הזה בכל שפה שתבחרו, בכתובות אינטרנט משלו, עם כתובות URL מתורגמות, מטא-דאטה, תפריטים, מוצרי WooCommerce, תגי hreflang, מפות אתר לכל שפה וקובץ llms.txt. תרגמו באמצעות תוכנית ה-Zinn Digital® שלכם או באמצעות מפתח ספק משלכם."

#. Author of the plugin
#: zinn-translate.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-translate.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-translate-admin.php:62
#: includes/class-zinn-translate-admin.php:632
#: includes/class-zinn-translate-admin.php:633
msgid "Translate"
msgstr "תרגם"

#: includes/class-zinn-translate-admin.php:76
#: includes/class-zinn-translate-admin.php:767
msgid "Manual overrides"
msgstr "עקיפות ידניות"

#: includes/class-zinn-translate-admin.php:81
#: includes/class-zinn-translate-admin.php:769
msgid "Sitemaps and URLs"
msgstr "מפות אתר וכתובות URL"

#: includes/class-zinn-translate-admin.php:111
msgid "General"
msgstr "כללי"

#: includes/class-zinn-translate-admin.php:116
msgid "Who pays for the translation"
msgstr "מי משלם עבור התרגום"

#: includes/class-zinn-translate-admin.php:117
msgid "Either your Zinn Digital® plan, or an API key of your own. There is no free tier — somebody pays a provider for every word."
msgstr "תוכנית Zinn Digital® שלכם, או מפתח API משלכם. אין שכבה חינמית — מישהו משלם לספק עבור כל מילה."

#: includes/class-zinn-translate-admin.php:120
#: includes/class-zinn-translate-admin.php:721
msgid "My Zinn Digital® plan"
msgstr "התוכנית שלי ב-Zinn Digital®"

#: includes/class-zinn-translate-admin.php:121
#: includes/class-zinn-translate-admin.php:722
msgid "My own provider key"
msgstr "מפתח הספק שלי"

#: includes/class-zinn-translate-admin.php:128
#: includes/class-zinn-translate-admin.php:726
msgid "Site ID"
msgstr "מזהה אתר"

#: includes/class-zinn-translate-admin.php:129
msgid "From your Zinn Digital® dashboard, on this site's Translation tab."
msgstr "מלוח הבקרה של Zinn Digital® שלך, בלשונית \"תרגום\" של אתר זה."

#: includes/class-zinn-translate-admin.php:136
#: includes/class-zinn-translate-admin.php:730
msgid "Site token"
msgstr "אסימון אתר"

#: includes/class-zinn-translate-admin.php:144
#: includes/class-zinn-translate-admin.php:734
msgid "Provider"
msgstr "ספק"

#: includes/class-zinn-translate-admin.php:154
#: includes/class-zinn-translate-admin.php:744
msgid "API key"
msgstr "מפתח API"

#: includes/class-zinn-translate-admin.php:155
msgid "Your key, billed to you by the provider. It is stored on this site and sent only to them."
msgstr "המפתח שלך, המחויב לך על ידי הספק. הוא מאוחסן באתר זה ונשלח אליו בלבד."

#: includes/class-zinn-translate-admin.php:163
msgid "Model"
msgstr "דגם"

#: includes/class-zinn-translate-admin.php:164
msgid "Leave empty for the cheapest model that does the job well."
msgstr "השאר ריק עבור הדגם הזול ביותר שעושה את העבודה היטב."

#: includes/class-zinn-translate-admin.php:171
msgid "This site is written in"
msgstr "אתר זה כתוב ב"

#: includes/class-zinn-translate-admin.php:172
msgid "Leave empty to use the site language from WordPress settings."
msgstr "השאר ריק כדי להשתמש בשפת האתר מתוך הגדרות WordPress."

#: includes/class-zinn-translate-admin.php:180
#: includes/class-zinn-translate-admin.php:748
msgid "Languages to publish"
msgstr "שפות לפרסום"

#: includes/class-zinn-translate-admin.php:181
msgid "Each one gets its own web addresses and its own sitemap. Publish only the languages you want indexed."
msgstr "לכל אחד מהם יש כתובות אתר משלו ומפת אתר משלו. פרסם רק את השפות שברצונך שיאונדקסו."

#: includes/class-zinn-translate-admin.php:188
msgid "Translate automatically when I publish or update"
msgstr "תרגם אוטומטית בעת פרסום או עדכון"

#: includes/class-zinn-translate-admin.php:189
msgid "Editing a page marks its translations out of date and they are remade in the background. Editing without changing any words costs nothing."
msgstr "עריכת עמוד מסמנת את התרגומים שלו כמיושנים והם מיוצרים מחדש ברקע. עריכה מבלי לשנות אף מילה אינה עולה דבר."

#: includes/class-zinn-translate-admin.php:196
msgid "What gets translated"
msgstr "מה שמתורגם"

#: includes/class-zinn-translate-admin.php:201
msgid "Post types"
msgstr "סוגי פוסטים"

#: includes/class-zinn-translate-admin.php:209
msgid "Translate the web addresses too"
msgstr "תרגם גם את כתובות אתרי האינטרנט"

#: includes/class-zinn-translate-admin.php:210
msgid "French visitors get /fr/a-propos/ rather than /fr/about/. The untranslated address keeps working and redirects, so nothing that was indexed breaks."
msgstr "מבקרים מצרפת יופנו לכתובת /fr/a-propos/ במקום ל-/fr/about/. הכתובת הלא מתורגמת תמשיך לעבוד ותבצע הפניה, כך ששום דבר שקוטלג לא ייהרס."

#: includes/class-zinn-translate-admin.php:217
msgid "Translate SEO titles, descriptions and image alt text"
msgstr "תרגם כותרות SEO, תיאורים ותיאורי טקסט חלופי לתמונות"

#: includes/class-zinn-translate-admin.php:224
msgid "Translate categories and tags"
msgstr "תרגם קטגוריות ותגיות"

#: includes/class-zinn-translate-admin.php:231
msgid "Translate navigation menus"
msgstr "תרגם תפריטי ניווט"

#: includes/class-zinn-translate-admin.php:238
msgid "Translate WooCommerce products and attributes"
msgstr "תרגם מוצרים ותכונות של WooCommerce"

#: includes/class-zinn-translate-admin.php:239
msgid "Short descriptions, purchase notes, attribute labels and variation descriptions. Prices, SKUs and stored option values are never touched."
msgstr "תיורים קצרים, הערות רכישה, תוויות תכונות ותיאורי וריאציות. מחירים, מק\"טים וערכי אפשרויות שמורים לעולם אינם נגעים."

#: includes/class-zinn-translate-admin.php:246
msgid "SEO"
msgstr "SEO"

#: includes/class-zinn-translate-admin.php:251
msgid "Add hreflang tags"
msgstr "הוסף תגי hreflang"

#: includes/class-zinn-translate-admin.php:252
msgid "Tells search engines these pages are the same page in different languages. Leave this on unless another plugin is already doing it."
msgstr "מורה למנועי חיפוש שעמודים אלה הם אותו עמוד בשפות שונות. השאר אפשרות זו פעילה אלא אם תוסף אחר כבר עושה זאת."

#: includes/class-zinn-translate-admin.php:259
msgid "Publish a sitemap for each language"
msgstr "פרסום מפת אתר לכל שפה"

#: includes/class-zinn-translate-admin.php:266
msgid "Publish llms.txt for each language"
msgstr "פרסום llms.txt עבור כל שפה"

#: includes/class-zinn-translate-admin.php:267
msgid "A plain-text map of the site that AI answer engines read. They often cannot run JavaScript and may never fetch a sitemap."
msgstr "מפת אתר בטקסט פשוט שמנועי תשובות המבוססים על בינה מלאכותית קוראים. לרוב אינם יכולים להריץ JavaScript וייתכן שלעולם לא ימשכו מפת אתר."

#: includes/class-zinn-translate-admin.php:274
#: includes/class-zinn-translate-switcher.php:135
msgid "Language switcher"
msgstr "בורר שפות"

#: includes/class-zinn-translate-admin.php:279
#: includes/class-zinn-translate-switcher-widget.php:83
msgid "Style"
msgstr "סגנון"

#: includes/class-zinn-translate-admin.php:282
msgid "Colours, spacing and corners are on the Styling tab. Place it with the block, the [zinn_language_switcher] shortcode, or a menu."
msgstr "צבעים, מרווחים ופינות נמצאים בלשונית העיצוב. ממקמים זאת עם הבלוק, ה-shortcode של [zinn_language_switcher], או בתפריט."

#: includes/class-zinn-translate-admin.php:289
msgid "Show only these languages"
msgstr "הצג שפות אלו בלבד"

#: includes/class-zinn-translate-admin.php:290
msgid "Leave empty to show every language you publish."
msgstr "השאר ריק כדי להציג את כל השפות שאתה מפרסם."

#: includes/class-zinn-translate-admin.php:297
msgid "Name each language in its own language"
msgstr "הגדר את שמה של כל שפה בשפתה שלה"

#: includes/class-zinn-translate-admin.php:298
msgid "Deutsch rather than German. Somebody who cannot read the current page cannot read \"German\" either."
msgstr "Deutsch במקום German. מי שאינו יכול לקרוא את הדף הנוכחי אינו יכול לקרוא גם את \"German\"."

#: includes/class-zinn-translate-admin.php:305
msgid "Show flags"
msgstr "הצג דגלים"

#: includes/class-zinn-translate-admin.php:306
msgid "Off by default: a language is not a country, and Arabic and Spanish have no single flag that does not exclude most of their speakers."
msgstr "כבוי כברירת מחדל: שפה אינה מדינה, ולערבית ולספרדית אין דגל יחיד שאינו מדיר את מרבית הדוברים שלהן."

#: includes/class-zinn-translate-admin.php:313
msgid "Include the language being read"
msgstr "כלול את השפת הקריאה"

#: includes/class-zinn-translate-admin.php:320
msgid "Include the original language"
msgstr "כלול את שפת המקור"

#: includes/class-zinn-translate-admin.php:327
msgid "Add it to this menu"
msgstr "הוסף אותו לתפריט הזה"

#: includes/class-zinn-translate-admin.php:328
msgid "Only the menu you name here. Nothing is added to any other menu on the site."
msgstr "רק התפריטים שתציין כאן. שום דבר לא יתווסף לאף תפריט אחר באתר."

#: includes/class-zinn-translate-admin.php:378
msgid "Accent"
msgstr "דגש"

#: includes/class-zinn-translate-admin.php:382
msgid "Background"
msgstr "רקע"

#: includes/class-zinn-translate-admin.php:386
msgid "Text"
msgstr "טקסט"

#: includes/class-zinn-translate-admin.php:390
msgid "Corner radius"
msgstr "רדיוס פינות"

#: includes/class-zinn-translate-admin.php:394
msgid "Spacing"
msgstr "רווחים"

#: includes/class-zinn-translate-admin.php:398
msgid "Text size"
msgstr "גודל טקסט"

#: includes/class-zinn-translate-admin.php:425
msgid "Do not add it to a menu"
msgstr "אל תוספו אותו לתפריט"

#: includes/class-zinn-translate-admin.php:480
msgid "Edit any translation here. An edited translation is kept exactly as you wrote it and is never overwritten when the page is translated again."
msgstr "ניתן לערוך כאן כל תרגום. תרגום שנערך יישמר בדיוק כפי שנכתב ולא יידרס לעולם בעת תרגום מחדש של הדף."

#: includes/class-zinn-translate-admin.php:501
msgid "Every language"
msgstr "כל שפה"

#: includes/class-zinn-translate-admin.php:508
msgid "Search translations"
msgstr "חיפוש תרגומים"

#: includes/class-zinn-translate-admin.php:509
msgid "Filter"
msgstr "סינון"

#: includes/class-zinn-translate-admin.php:514
msgid "Content"
msgstr "תוכן"

#: includes/class-zinn-translate-admin.php:515
msgid "Language"
msgstr "שפה"

#: includes/class-zinn-translate-admin.php:516
msgid "Translation"
msgstr "תרגום"

#: includes/class-zinn-translate-admin.php:517
msgid "Status"
msgstr "סטטוס"

#: includes/class-zinn-translate-admin.php:518
#: includes/class-zinn-translate-admin.php:537
msgid "Save"
msgstr "שמור"

#: includes/class-zinn-translate-admin.php:523
msgid "Nothing translated yet. Publish a language and translation starts in the background."
msgstr "טרם תורגם דבר. פרסם שפה והתרגום יחל ברקע."

#: includes/class-zinn-translate-admin.php:556
msgid "These addresses are live. Open any of them to check it, and submit the sitemap index to Google Search Console."
msgstr "כתובות אלו פעילות. פתח כל אחת מהן כדי לבדוק אותה, והגש את מפתח מפת האתר אל Google Search Console."

#: includes/class-zinn-translate-admin.php:577
msgid "You are not allowed to edit translations on this site."
msgstr "אינך מורשה לערוך תרגומים באתר זה."

#: includes/class-zinn-translate-admin.php:605
msgid "Edited by you — kept"
msgstr "נערך על ידך — נשמר"

#: includes/class-zinn-translate-admin.php:607
msgid "Source changed — will be redone"
msgstr "הקוד שונה — יבוצע מחדש"

#: includes/class-zinn-translate-admin.php:609
msgid "Up to date"
msgstr "מעודכן"

#: includes/class-zinn-translate-admin.php:621
#: includes/class-zinn-translate-admin.php:622
msgid "Zinn®"
msgstr "Zinn®"

#: includes/class-zinn-translate-admin.php:719
msgid "Who pays"
msgstr "מי משלם"

#: includes/class-zinn-translate-admin.php:751
msgid "Comma separated, for example: fr, de, ar"
msgstr "מופרדים בפסקים, לדוגמה: fr, de, ar"

#: includes/class-zinn-translate-admin.php:755
msgid "Switcher style"
msgstr "סגנון מחלף"

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-translate-promo.php:241
#: includes/class-zinn-translate-promo.php:299
#, php-format
msgid "%s — guides and services"
msgstr "%s — מדריכים ושירותים"

#: includes/class-zinn-translate-promo.php:256
msgid "User guides"
msgstr "מדריכי משתמש"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-translate-promo.php:306
#, php-format
msgid "Read the %s user guide"
msgstr "קרא את מדריך המשתמש של %s"

#: includes/class-zinn-translate-promo.php:314
msgid "Hide this"
msgstr "הסתר את זה"

#: includes/class-zinn-translate-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "אחסון Zinn® עבור WordPress"

#: includes/class-zinn-translate-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, גיבויים יומיים, מעבר חינם ולוח בקרה המותאם לאנשים המנהלים יותר מאתר אחד."

#: includes/class-zinn-translate-promo.php:381
msgid "The Zinn® marketplace"
msgstr "החנות של Zinn®"

#: includes/class-zinn-translate-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "קנו ומכרו אתרים מבוססים, דומיינים ומיקומי קישורים, כאשר הכסף מוחזק בבטחה עד ששני הצדדים מרוצים."

#: includes/class-zinn-translate-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® — שכרו אנשים שעוסקים בזה למחייתם"

#: includes/class-zinn-translate-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "זירת הפרילנסרים הגלובלית שלנו: עיין בלמעלה מ-10,000 שירותים מוכנים מראש מסופרים, מעצבים, מפתחים ואנשי קידום אתרים, או פרסם פרויקט ותן להם להגיש הצעות."

#: includes/class-zinn-translate-prompt.php:211
msgid "The API key was rejected. Check that it is still valid and has translation access, then save it again."
msgstr "מפתח ה-API נדחה. בדוק שהוא עדיין תקף ויש לו גישת תרגום, ולאחר מכן שמור אותו שוב."

#: includes/class-zinn-translate-prompt.php:218
msgid "The provider refused on billing or quota. Nothing was translated. Check the balance and limits on your account with them."
msgstr "הספק סירב עקב בעיית חיוב או מכסה. דבר לא תורגם. בדוק את היתרה והמגבלות בחשבונך אצלם."

#: includes/class-zinn-translate-prompt.php:225
msgid "The translation provider is having a problem at their end. Nothing was translated or charged, and it will try again on the next pass."
msgstr "ספק התרגום נתקל בבעיה בצד שלו. דבר לא תורגם או חויב, והמערכת תנסה שוב בסבב הבא."

#: includes/class-zinn-translate-prompt.php:231
msgid "The translation request failed and we could not tell why. Nothing was saved."
msgstr "בקשת התרגום נכשלה ולא הצלחנו לדעת מדוע. דבר לא נשמר."

#: includes/class-zinn-translate-sitemap.php:130
msgid "Sitemap index"
msgstr "מפת אתרים ראשית"

#. translators: %s: a language name, for example "French".
#: includes/class-zinn-translate-sitemap.php:134
#, php-format
msgid "%s sitemap"
msgstr "%s מפת אתר"

#: includes/class-zinn-translate-sitemap.php:138
msgid "LLM content map"
msgstr "מפת תוכן של LLM"

#. translators: %s: a language name, for example "French".
#: includes/class-zinn-translate-sitemap.php:141
#, php-format
msgid "%s LLM content map"
msgstr "%s מפת תוכן של LLM"

#: includes/class-zinn-translate-status.php:96
msgid "Languages published"
msgstr "שפות שפורסמו"

#: includes/class-zinn-translate-status.php:100
msgid "Site language"
msgstr "שפת האתר"

#: includes/class-zinn-translate-status.php:106
msgid "SEO plugin"
msgstr "תוסף SEO"

#: includes/class-zinn-translate-status.php:134
msgid "No translation provider is set up yet."
msgstr "עדיין לא הוגדר ספק תרגום."

#: includes/class-zinn-translate-status.php:135
msgid "Paste an API key from your chosen provider, or connect the site to a Zinn Digital® account, and translation starts on the next pass."
msgstr "הדבק מפתח API מהספק שבחרת, או חבר את האתר לחשבון Zinn Digital®, והתרגום יתחיל במעבר הבא."

#. translators: %s: a translation provider's name, for example "DeepL".
#: includes/class-zinn-translate-status.php:144
#, php-format
msgid "Translating with your own %s key."
msgstr "מתרגם באמצעות מפתח ה-%s שלך."

#: includes/class-zinn-translate-status.php:147
msgid "This site is not connected to a Zinn Digital® account, which is fine — your provider bills you directly."
msgstr "אתר זה אינו מחובר לחשבון Zinn Digital®, וזה בסדר — ספק השירות שלך מחייב אותך ישירות."

#: includes/class-zinn-translate-status.php:156
msgid "Not connected to Zinn Digital® yet."
msgstr "עדיין לא מחובר/ת ל-Zinn Digital®."

#: includes/class-zinn-translate-status.php:157
msgid "Add this site's ID and token from your Zinn Digital® dashboard, or switch to your own provider key to run without an account."
msgstr "הוסף את המזהה והאסימון של אתר זה מלוח הבקרה של Zinn Digital® שלך, או עבר לפתח ספק משלך כדי לפעול ללא חשבון."

#: includes/class-zinn-translate-status.php:164
msgid "Connected to Zinn Digital®."
msgstr "מחובר אל Zinn Digital®."

#: includes/class-zinn-translate-status.php:179
msgid "The translation provider is having a problem."
msgstr "ספק התרגום נתקל בבעיה."

#: includes/class-zinn-translate-status.php:181
msgid "Translation is paused — your provider needs attention."
msgstr "התרגום מושהה — הספק שלך דורש טיפול."

#: includes/class-zinn-translate-status.php:183
msgid "Translation has not been set up yet."
msgstr "התרגום טרם הוגדר."

#: includes/class-zinn-translate-status.php:188
msgid "Something went wrong at our end."
msgstr "משהו הששתבש בצד שלנו."

#: includes/class-zinn-translate-status.php:200
msgid "Check their status page"
