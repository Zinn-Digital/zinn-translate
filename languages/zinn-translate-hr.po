msgstr "Uvezi"

#: includes/class-zinn-translate-admin-ui.php:997
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "Izvezene datoteke nikada ne sadrže lozinke, tokene ili API ključeve — morat ćete ih ponovno unijeti na novom web-mjestu."

#: includes/class-zinn-translate-admin-ui.php:1096
msgid "Settings saved."
msgstr "Postavke su spremljene."

#: includes/class-zinn-translate-admin-ui.php:1143
msgid "Every setting on this plugin is back to its default."
msgstr "Sve postavke ovog priključka vraćene su na zadane vrijednosti."

#: includes/class-zinn-translate-admin-ui.php:1186
