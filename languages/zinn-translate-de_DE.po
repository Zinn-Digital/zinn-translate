msgstr "Eckradius"

#: includes/class-zinn-translate-admin.php:394
msgid "Spacing"
msgstr "Abstand"

#: includes/class-zinn-translate-admin.php:398
msgid "Text size"
msgstr "Textgröße"

#: includes/class-zinn-translate-admin.php:425
msgid "Do not add it to a menu"
msgstr "Fügen Sie es keinem Menü hinzu"

#: includes/class-zinn-translate-admin.php:480
msgid "Edit any translation here. An edited translation is kept exactly as you wrote it and is never overwritten when the page is translated again."
msgstr "Bearbeiten Sie hier eine beliebige Übersetzung. Eine bearbeitete Übersetzung wird exakt so beibehalten, wie Sie sie geschrieben haben, und wird beim erneuten Übersetzen der Seite niemals überschrieben."

#: includes/class-zinn-translate-admin.php:501
msgid "Every language"
msgstr "Jede Sprache"

#: includes/class-zinn-translate-admin.php:508
msgid "Search translations"
msgstr "Übersetzungen suchen"

#: includes/class-zinn-translate-admin.php:509
msgid "Filter"
msgstr "Filter"

#: includes/class-zinn-translate-admin.php:514
