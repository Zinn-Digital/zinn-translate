msgstr "ನಿಮ್ಮ Zinn Digital® ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಿಂದ, ಈ ಸೈಟ್‌ನ ಅನುವಾದ ಟ್ಯಾಬ್‌ನಲ್ಲಿ."

#: includes/class-zinn-translate-admin.php:136
#: includes/class-zinn-translate-admin.php:730
msgid "Site token"
msgstr "ಸೈಟ್ ಟೋಕನ್"

