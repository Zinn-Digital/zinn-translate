msgstr "Cheia ta, facturată de furnizor. Este stocată pe acest site și trimisă doar către acesta."

#: includes/class-zinn-translate-admin.php:166
msgid "Model"
msgstr "Model"

#: includes/class-zinn-translate-admin.php:167
