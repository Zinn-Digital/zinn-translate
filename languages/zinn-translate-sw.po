#: includes/class-zinn-translate-status.php:106
msgid "SEO plugin"
msgstr "Programu jalizi ya SEO"

#: includes/class-zinn-translate-status.php:134
msgid "No translation provider is set up yet."
msgstr "Hakuna mtoa huduma wa tafsiri aliyewekwa bado."

#: includes/class-zinn-translate-status.php:135
msgid "Paste an API key from your chosen provider, or connect the site to a Zinn Digital® account, and translation starts on the next pass."
msgstr "Bandika ufunguo wa API kutoka kwa mtoa huduma uliyemchagua, au unganisha tovuti na akaunti ya Zinn Digital®, na tafsiri itaanza katika duru inayofuata."

#. translators: %s: a translation provider's name, for example "DeepL".
#: includes/class-zinn-translate-status.php:144
#, php-format
msgid "Translating with your own %s key."
msgstr "Inatafsiriwa kwa ufunguo wako mwenyewe wa %s."

#: includes/class-zinn-translate-status.php:147
msgid "This site is not connected to a Zinn Digital® account, which is fine — your provider bills you directly."
msgstr "Tovuti hii haijaunganishwa na akaunti ya Zinn Digital®, jambo ambalo ni sawa — mtoa huduma wako anakutoza moja kwa moja."

#: includes/class-zinn-translate-status.php:156
msgid "Not connected to Zinn Digital® yet."
msgstr "Bado hujaunganishwa na Zinn Digital®."

#: includes/class-zinn-translate-status.php:157
msgid "Add this site's ID and token from your Zinn Digital® dashboard, or switch to your own provider key to run without an account."
msgstr "Ongeza kitambulisho na tokeni ya tovuti hii kutoka kwenye dashibodi yako ya Zinn Digital®, au ubadilishe hadi ufunguo wako mwenyewe wa mtoa huduma ili uendeshe bila akaunti."

#: includes/class-zinn-translate-status.php:164
msgid "Connected to Zinn Digital®."
msgstr "Imeunganishwa na Zinn Digital®."

#: includes/class-zinn-translate-status.php:179
msgid "The translation provider is having a problem."
msgstr "Mtoa huduma wa tafsiri anapata tatizo."

#: includes/class-zinn-translate-status.php:181
msgid "Translation is paused — your provider needs attention."
msgstr "Tafsiri imesitishwa — mtoa huduma wako anahitaji uangalifu."

#: includes/class-zinn-translate-status.php:183
msgid "Translation has not been set up yet."
msgstr "Tafsiri bado haijasakinishwa."

#: includes/class-zinn-translate-status.php:188
msgid "Something went wrong at our end."
msgstr "Kuna kitu kimeenda vibaya upande wetu."

#: includes/class-zinn-translate-status.php:200
msgid "Check their status page"
msgstr "Angalia ukurasa wao wa hali"

#: includes/class-zinn-translate-status.php:201
msgid "Fix this on your account"
msgstr "Rekebisha hili kwenye akaunti yako"

