msgstr[0] "Mpangilio %d umeingizwa. Manenosiri na funguo za API haziwahi kujumuishwa kwenye faili la nje, kwa hivyo weka hizo tena."
msgstr[1] "Mipangilio %d imeletwa. Nywila na funguo za API haziingizwi kamwe kwenye faili inayouzwa nje, kwa hivyo weka hizo tena."

#: includes/class-zinn-translate-admin.php:65
msgid "Translate"
msgstr "Tafsiri"

#: includes/class-zinn-translate-admin.php:79
