msgstr[0] "%d habayn ayaa la soo dejiyay. Erayada sirta ah iyo furayaasha API waligood kuma jiraan dhoofinta, markaa dib u geli kuwaas."
msgstr[1] "%d habayn ayaa la soo dejiyay. Furaha sirta ah iyo furayaasha API waligood kuma jiraan wax la dhoofiyay, markaa fadlan mar kale geli kuwaas."

#: includes/class-zinn-translate-admin.php:65
