msgstr[0] "%d dejin ayaa la soo dejiyay. Furayaasha sirta ah iyo furayaasha API-ga laguma daro dhoofinta, markaa fadlan mar kale gali kuwaas."
msgstr[1] "%d dejinta waa la soo dhoofiyay. Erayada sirta ah iyo furayaasha API-ga laguma daro dhoofinta, markaa fadlan mar kale gali kuwaas."

#: includes/class-zinn-translate-admin.php:65
