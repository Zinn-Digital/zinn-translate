msgstr "Թարգմանեք նաև վեբ հասցեները"

#: includes/class-zinn-translate-admin.php:213
msgid "French visitors get /fr/a-propos/ rather than /fr/about/. The untranslated address keeps working and redirects, so nothing that was indexed breaks."
msgstr "Ֆրանսերեն այցելուները ստանում են /fr/a-propos/՝ /fr/about/-ի փոխարեն։ Չթարգմանված հասցեն շարունակում է աշխատել և վերահղում է, ուստի ինդեքսավորված որևէ բան չի կոտրվում:"

#: includes/class-zinn-translate-admin.php:220
msgid "Translate SEO titles, descriptions and image alt text"
msgstr "Թարգմանել SEO վերնագրերը, նկարագրությունները և պատկերների այլընտրանքային տեքստը"

#: includes/class-zinn-translate-admin.php:227
msgid "Translate categories and tags"
msgstr "Թարգմանել կատեգորիաներն ու պիտակները"

#: includes/class-zinn-translate-admin.php:234
msgid "Translate navigation menus"
msgstr "Թարգմանել նավարկման ընտրացանկերը"

#: includes/class-zinn-translate-admin.php:241
msgid "Translate WooCommerce products and attributes"
msgstr "Թարգմանել WooCommerce-ի ապրանքներն ու հատկանիշները"

#: includes/class-zinn-translate-admin.php:242
msgid "Short descriptions, purchase notes, attribute labels and variation descriptions. Prices, SKUs and stored option values are never touched."
msgstr "Կարճ նկարագրություններ, գնման նշումներ, հատկանիշների պիտակներ և տարբերակների նկարագրություններ: Գները, SKU-ները և պահպանված տարբերակների արժեքները երբեք չեն շոշափվում:"

#: includes/class-zinn-translate-admin.php:249
msgid "SEO"
msgstr "SEO"

#: includes/class-zinn-translate-admin.php:254
msgid "Add hreflang tags"
msgstr "Ավելացնել hreflang պիտակներ"

#: includes/class-zinn-translate-admin.php:255
msgid "Tells search engines these pages are the same page in different languages. Leave this on unless another plugin is already doing it."
msgstr "Որոնողական համակարգերին տեղեկացնում է, որ այս էջերը նույն էջն են տարբեր լեզուներով: Թողեք սա ակտիվ, եթե մեկ այլ փլագին արդեն չի անում դա:"

#: includes/class-zinn-translate-admin.php:262
msgid "Publish a sitemap for each language"
msgstr "Հրապարակեք տեղեկատվական քարտեզ (sitemap) յուրաքանչյուր լեզվի համար"

#: includes/class-zinn-translate-admin.php:269
msgid "Publish llms.txt for each language"
msgstr "Հրապարակել llms.txt յուրաքանչյուր լեզվի համար"

#: includes/class-zinn-translate-admin.php:270
msgid "A plain-text map of the site that AI answer engines read. They often cannot run JavaScript and may never fetch a sitemap."
