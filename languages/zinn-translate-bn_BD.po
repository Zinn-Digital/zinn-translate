#: includes/class-zinn-translate-admin.php:204
msgid "Post types"
msgstr "পোস্টের ধরন"

#: includes/class-zinn-translate-admin.php:212
msgid "Translate the web addresses too"
msgstr "ওয়েব ঠিকানাগুলোও অনুবাদ করুন"

#: includes/class-zinn-translate-admin.php:213
msgid "French visitors get /fr/a-propos/ rather than /fr/about/. The untranslated address keeps working and redirects, so nothing that was indexed breaks."
msgstr "ফরাসি দর্শনার্থীরা /fr/about/-এর পরিবর্তে /fr/a-propos/ পান। অনুবাদের বাইরে থাকা ঠিকানাটি কাজ করতে থাকে এবং রিডাইরেক্ট হয়, তাই ইনডেক্স করা কোনো কিছু নষ্ট হয় না।"

#: includes/class-zinn-translate-admin.php:220
msgid "Translate SEO titles, descriptions and image alt text"
msgstr "এসইও শিরোনাম, বিবরণ এবং ছবির অল্ট পাঠ্য অনুবাদ করুন"

#: includes/class-zinn-translate-admin.php:227
