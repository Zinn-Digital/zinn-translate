#: includes/class-zinn-translate-promo.php:314
msgid "Hide this"
msgstr "ഇത് മറയ്ക്കുക"

#: includes/class-zinn-translate-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "WordPress-നായുള്ള Zinn® ഹോസ്റ്റിംഗ്"

#: includes/class-zinn-translate-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, ദിവസേനയുള്ള ബാക്കപ്പുകൾ, സൗജന്യ മൈഗ്രേഷൻ, ഒന്നിൽ കൂടുതൽ സൈറ്റുകൾ കൈകാര്യം ചെയ്യുന്നവർക്കായി നിർമ്മിച്ച കൺട്രോൾ പാനൽ."

#: includes/class-zinn-translate-promo.php:381
msgid "The Zinn® marketplace"
msgstr "Zinn® മാര്‍ക്കറ്റ്‌പ്ലേസ്"

#: includes/class-zinn-translate-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "സ്ഥിരസ്ഥാപിതമായ സൈറ്റുകളും ഡൊമേനുകളും ലിങ്ക് പ്ലേസ്‌മെന്റുകളും വാങ്ങുകയും വിൽക്കുകയും ചെയ്യുക, രണ്ട് കക്ഷികളും തൃപ്തരാകുന്നത് വരെ പണം സുരക്ഷിതമായി സൂക്ഷിക്കും."

#: includes/class-zinn-translate-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® — ഇതിനായി ജീവിക്കുന്ന ആളുകളെ നിയമിക്കുക"

#: includes/class-zinn-translate-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "ഞങ്ങളുടെ ആഗോള ഫ്രീലാൻസ് മാർക്കറ്റ്പ്ലേസ്: എഴുത്തുകാർ, ഡിസൈനർമാർ, ഡെവലപ്പർമാർ, എസ്‌ഇഒ വിദഗ്ധർ എന്നിവരിൽ നിന്നുള്ള 10,000-ത്തിലധികം റെഡിമെയ്ഡ് സേവനങ്ങൾ ബ്രൗസ് ചെയ്യുക, അല്ലെങ്കിൽ ഒരു പ്രോജക്റ്റ് പോസ്റ്റ് ചെയ്ത് അവരെ ബിഡ് ചെയ്യാൻ അനുവദിക്കുക."

#: includes/class-zinn-translate-settings.php:170
msgid "Your site is translated by Zinn Digital®. Choose the languages to publish, and each one is served on its own web address with the right hreflang tags."
msgstr "നിങ്ങളുടെ സൈറ്റ് Zinn Digital® തർജ്ജമ ചെയ്തിരിക്കുന്നു. പ്രസിദ്ധീകരിക്കേണ്ട ഭാഷകൾ തിരഞ്ഞെടുക്കുക, അവ ഓരോന്നും ശരിയായ hreflang ടാഗുകളോട് കൂടിയ സ്വന്തം വെബ് വിലാസത്തിൽ ലഭ്യമാകും."

#: includes/class-zinn-translate-settings.php:180
msgid "Site ID"
msgstr "സൈറ്റ് ഐഡി"

#: includes/class-zinn-translate-settings.php:183
msgid "From your Zinn Digital® dashboard, on this site's Translation tab."
msgstr "നിങ്ങളുടെ Zinn Digital® ഡാഷ്‌ബോർഡിൽ നിന്ന്, ഈ സൈറ്റിന്റെ വിവർത്തന ടാബിൽ."

#: includes/class-zinn-translate-settings.php:187
msgid "Read-only token"
msgstr "റീഡ്-ഒൺലി ടോക്കൺ"

#: includes/class-zinn-translate-settings.php:190
msgid "Read-only. It can fetch this site's translations and nothing else."
msgstr "റീഡ്-ഒൺലി. ഇതിന് ഈ സൈറ്റിന്റെ വിവർത്തനങ്ങൾ മാത്രമേ ലഭ്യമാക്കാൻ കഴിയൂ, മറ്റൊന്നും കഴിയില്ല."

#: includes/class-zinn-translate-settings.php:194
msgid "Languages to publish"
msgstr "പ്രസിദ്ധീകരിക്കേണ്ട ഭാഷകൾ"

#: includes/class-zinn-translate-settings.php:197
msgid "Comma separated, for example: fr, de, es. Leave empty to publish none."
msgstr "കോമയാൽ വേർതിരിച്ചത്, ഉദാഹരണത്തിന്: fr, de, es. ഒന്നും പ്രസിദ്ധീകരിക്കാൻ ഇല്ലെങ്കിൽ ഇത് ശൂന്യമായിടുക."

#: includes/class-zinn-translate-updater.php:233
msgid "See the Zinn Digital® release notes."
msgstr "Zinn Digital® റിലീസ് കുറിപ്പുകൾ കാണുക."

#: includes/class-zinn-translate-updater.php:288
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ഡൗൺലോഡ് ചെയ്ത അപ്‌ഡേറ്റിന്റെ സമഗ്രതാ പരിശോധന പരാജയപ്പെട്ടു, അതിനാൽ അത് ഇൻസ്റ്റാൾ ചെയ്തില്ല."
