#: includes/class-zinn-translate-admin.php:722
msgid "My own provider key"
msgstr "ਮੇਰੀ ਆਪਣੀ ਪ੍ਰਦਾਤਾ ਕੁੰਜੀ"

#: includes/class-zinn-translate-admin.php:128
#: includes/class-zinn-translate-admin.php:726
