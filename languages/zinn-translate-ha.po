msgstr[1] "An shigo da saituna %d. Ba a haɗa kalmomin sirri da maɓallan API a cikin fitarwa ba, saboda haka a sake shigar da su."

#: includes/class-zinn-translate-admin.php:65
msgid "Translate"
msgstr "Fassara"

#: includes/class-zinn-translate-admin.php:79
msgid "Manual overrides"
