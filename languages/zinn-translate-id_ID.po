#. Plugin Name of the plugin
#: zinn-translate.php
#: includes/class-zinn-translate-admin.php:706
msgid "Zinn® Translate"
msgstr "Zinn® Translate"

#. Plugin URI of the plugin
#: zinn-translate.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-translate"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-translate"

#. Description of the plugin
#: zinn-translate.php
msgid "Publishes this site in every language you choose, on its own web addresses, with translated slugs, metadata, menus, WooCommerce products, hreflang, per-language sitemaps and llms.txt. Translate with your Zinn Digital® plan or with your own provider key."
msgstr "Menerbitkan situs ini dalam setiap bahasa yang Anda pilih, di alamat webnya sendiri, dengan slug, metadata, menu, produk WooCommerce, hreflang, peta situs per bahasa, dan llms.txt yang diterjemahkan. Terjemahkan dengan paket Zinn Digital® Anda atau dengan kunci penyedia Anda sendiri."

#. Author of the plugin
#: zinn-translate.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-translate.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

