msgstr "Svako podešavanje na ovom dodacima je vraćeno na podrazumevane vrednosti."

#: includes/class-zinn-translate-admin-ui.php:1103
msgid "Done."
msgstr "Gotovo."

#: includes/class-zinn-translate-admin-ui.php:1107
