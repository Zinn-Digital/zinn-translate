msgstr "Pogledajte napomene o izdanju za Zinn Digital®."

#: includes/class-zinn-translate-updater.php:288
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Preuzeto ažuriranje nije prošlo proveru integriteta i nije instalirano."

#: includes/providers/class-zinn-translate-provider-deepl.php:157
msgid "No DeepL API key is saved, so there is nothing to translate with."
msgstr "Nijedan DeepL API ključ nije sačuvan, tako da nema ničega sa čime bi se moglo prevoditi."

#. translators: %s: a language name, for example "Swahili".
#: includes/providers/class-zinn-translate-provider-deepl.php:165
#, php-format
msgid "DeepL does not translate into %s. Choose Google Gemini or OpenAI for this language, or connect the site to Zinn Digital®."
msgstr "DeepL ne prevodi na %s. Izaberite Google Gemini ili OpenAI za ovaj jezik ili povežite sajt sa Zinn Digital®."

#: includes/providers/class-zinn-translate-provider-deepl.php:207
msgid "DeepL could not be reached. Nothing was translated and nothing was charged; it will try again on the next pass."
msgstr "Nije moguće uspostaviti vezu sa uslugom DeepL. Ništa nije prevedeno niti naplaćeno; usluga će pokušati ponovo u sledećem prolazu."

#: includes/providers/class-zinn-translate-provider-deepl.php:219
