#: includes/class-zinn-translate-admin.php:537
msgid "Save"
msgstr "Сачувај"

#: includes/class-zinn-translate-admin.php:523
msgid "Nothing translated yet. Publish a language and translation starts in the background."
msgstr "Ništa još nije prevedeno. Objavite jezik i prevod počinje u pozadini."

#: includes/class-zinn-translate-admin.php:556
msgid "These addresses are live. Open any of them to check it, and submit the sitemap index to Google Search Console."
msgstr "Ove adrese su aktivne. Otvorite bilo koju od njih da biste je proverili i pošaljite indeks sitemapa na Google Search Console."

#: includes/class-zinn-translate-admin.php:577
msgid "You are not allowed to edit translations on this site."
msgstr "Nije vam dozvoljeno da uređujete prevode na ovoj veb-lokaciji."

#: includes/class-zinn-translate-admin.php:605
msgid "Edited by you — kept"
msgstr "Uredili ste Vi — sačuvano"

#: includes/class-zinn-translate-admin.php:607
msgid "Source changed — will be redone"
msgstr "Izvor je promenjen — biće ponovljeno"

#: includes/class-zinn-translate-admin.php:609
msgid "Up to date"
msgstr "Ažurno"

#: includes/class-zinn-translate-admin.php:621
#: includes/class-zinn-translate-admin.php:622
msgid "Zinn®"
msgstr "Zinn®"

#: includes/class-zinn-translate-admin.php:719
msgid "Who pays"
msgstr "Ko plaća"

#: includes/class-zinn-translate-admin.php:751
