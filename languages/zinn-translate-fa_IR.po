msgstr "نقشه محتوای LLM"

#. translators: %s: a language name, for example "French".
#: includes/class-zinn-translate-sitemap.php:141
#, php-format
msgid "%s LLM content map"
msgstr "%s نقشه محتوای LLM"

#: includes/class-zinn-translate-status.php:96
msgid "Languages published"
msgstr "زبان‌های منتشرشده"

#: includes/class-zinn-translate-status.php:100
msgid "Site language"
msgstr "زبان سایت"

#: includes/class-zinn-translate-status.php:106
msgid "SEO plugin"
msgstr "افزونه سئو"

#: includes/class-zinn-translate-status.php:134
msgid "No translation provider is set up yet."
msgstr "هنوز هیچ ارائه‌دهنده ترجمه‌ای راه‌اندازی نشده است."

#: includes/class-zinn-translate-status.php:135
msgid "Paste an API key from your chosen provider, or connect the site to a Zinn Digital® account, and translation starts on the next pass."
msgstr "یک کلید API از ارائه‌دهنده انتخابی خود قرار دهید یا سایت را به یک حساب کاربری Zinn Digital® متصل کنید، و ترجمه در دور بعدی آغاز می‌شود."

#. translators: %s: a translation provider's name, for example "DeepL".
#: includes/class-zinn-translate-status.php:144
#, php-format
msgid "Translating with your own %s key."
msgstr "ترجمه با کلید %s خود شما."

#: includes/class-zinn-translate-status.php:147
msgid "This site is not connected to a Zinn Digital® account, which is fine — your provider bills you directly."
